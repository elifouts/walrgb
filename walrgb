#!/usr/bin/env python3
"""walrgb - sync openrgb hardware lighting to pywal colors."""
import colorsys, curses, glob, json, os, socket, struct, sys, time

HOST = os.environ.get("WALRGB_HOST", "127.0.0.1")
PORT = int(os.environ.get("WALRGB_PORT", "6742"))
CFG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
CACHE_HOME = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
STATE_HOME = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
CFG = os.path.join(CFG_HOME, "walrgb", "config.json")
WAL = os.path.join(CACHE_HOME, "wal", "colors")
ROLES = os.path.join(CFG_HOME, "hypr", "state", "color-roles.json")  # accent picker from my dotfiles, optional
COUNT = os.path.join(CACHE_HOME, "walrgb", "devices")
HID = os.path.join(CACHE_HOME, "walrgb", "hid")
OWNED = os.path.join(STATE_HOME, "walrgb", "owned.json")

BLACK, BLUE = (0, 0, 0), "#0000ff"
PRESETS = ["#0000ff", "#00a2ff", "#00ffd5", "#00ff3c", "#ffd000", "#ff6a00", "#ff0033", "#ff00c8", "#8000ff", "#ffffff"]
NO_WAL_CYCLE = ["#0000ff", "#00a2ff", "#8000ff", "#ff00c8"]
MODES = ("static", "rainbow", "cycle")
FACTORY = ("rainbow wave", "rainbow", "spectrum cycle", "color cycle", "color wave", "spectrum")
DEFAULT = {"enabled": True, "color": "accent", "manual": BLUE, "accent": None, "mode": "static", "speed": 50,
           "brightness": 100, "balance": [1.0, 1.0, 1.0], "colors": [], "devices": {}, "zones": {}}
AUTO_ZONE = 60  # argb headers start at 0 leds. extra leds past the real strip are just ignored by the hardware

P_COUNT, P_DATA, P_PROTO, P_RESCAN, P_NAME, P_RESIZE, P_LEDS, P_MODE = 0, 1, 40, 140, 50, 1000, 1050, 1101
PROTO = 3  # first version with brightness in modes. without it msi/gigabyte silently ignore mode changes
F_BRIGHT, F_PER_LED, F_MODE_COLOR = 1 << 4, 1 << 5, 1 << 6
CM_PER_LED, CM_MODE = 1, 2
MODE_KEYS = ("value", "flags", "speed_min", "speed_max", "brightness_min", "brightness_max", "colors_min", "colors_max",
             "speed", "brightness", "direction", "color_mode")
MODE_FMT = "<iIIIIIIIIIII"
TYPES = ("motherboard", "ram", "gpu", "cooler", "ledstrip", "keyboard", "mouse", "mousemat", "headset",
         "headset stand", "gamepad", "light", "speaker", "virtual", "storage", "case", "microphone",
         "accessory", "keypad")
PERIPHERALS = {"keyboard", "mouse", "mousemat", "headset", "headset stand", "gamepad", "speaker", "microphone", "keypad"}


# ---- openrgb sdk client ----

class Reader:
    def __init__(self, b): self.b, self.o = b, 0

    def u(self, fmt):
        v = struct.unpack_from(fmt, self.b, self.o)
        self.o += struct.calcsize(fmt)
        return v if len(v) > 1 else v[0]

    def str(self):
        n = self.u("<H")
        self.o += n
        return self.b[self.o - n:self.o].rstrip(b"\0").decode(errors="replace")

    def colors(self):
        return [self.u("<4B")[:3] for _ in range(self.u("<H"))]


def parse_device(b, idx):
    r = Reader(b)
    r.u("<I")
    t = r.u("<i")
    d = {"idx": idx, "type": TYPES[t] if 0 <= t < len(TYPES) else "unknown", "name": r.str(), "vendor": r.str()}
    d["desc"], d["version"], d["serial"], d["location"] = r.str(), r.str(), r.str(), r.str()
    n_modes, d["active"] = r.u("<H"), r.u("<i")
    d["modes"] = []
    for _ in range(n_modes):
        m = {"name": r.str()}
        m.update(zip(MODE_KEYS, r.u(MODE_FMT)))
        m["colors"] = r.colors()
        d["modes"].append(m)
    d["zones"] = []
    for _ in range(r.u("<H")):
        z = {"name": r.str(), "matrix": None}
        z["type"], z["min"], z["max"], z["leds"] = r.u("<iIII")
        size = r.u("<H")
        end = r.o + size
        if size >= 8:  # keyboards ship a key grid, it's what makes per-key effects line up
            h, w = r.u("<II")
            z["matrix"] = (h, w, struct.unpack_from(f"<{h * w}I", r.b, r.o))
        r.o = end
        d["zones"].append(z)
    d["leds"] = []
    for _ in range(r.u("<H")):
        d["leds"].append(r.str())
        r.u("<I")
    d["colors"] = r.colors()
    return d


def pack_colors(cs):
    return struct.pack("<H", len(cs)) + b"".join(struct.pack("4B", *c, 0) for c in cs)


class OpenRGB:
    def __init__(self, wait=0):
        end = time.monotonic() + wait
        while True:
            try:
                self.sock = socket.create_connection((HOST, PORT), 2)
                break
            except OSError:
                if time.monotonic() >= end:
                    raise ConnectionError(f"can't reach openrgb at {HOST}:{PORT}. is walrgb-openrgb.service running?")
                time.sleep(1)
        self.send(P_PROTO, data=struct.pack("<I", PROTO))
        if struct.unpack("<I", self.recv(P_PROTO))[0] < PROTO:
            raise ConnectionError("openrgb is too old, walrgb needs 0.6 or newer")
        self.send(P_NAME, data=b"walrgb\0")

    def send(self, pid, dev=0, data=b""):
        self.sock.sendall(b"ORGB" + struct.pack("<III", dev, pid, len(data)) + data)

    def _read(self, n):
        b = b""
        while len(b) < n:
            c = self.sock.recv(n - len(b))
            if not c:
                raise ConnectionError("openrgb closed the connection")
            b += c
        return b

    def recv(self, want):
        while True:  # server pushes device-list-updated packets at us sometimes, skip them
            _, _, pid, n = struct.unpack("<4sIII", self._read(16))
            body = self._read(n)
            if pid == want:
                return body

    def count(self):
        self.send(P_COUNT)
        return struct.unpack("<I", self.recv(P_COUNT))[0]

    def device(self, i):
        self.send(P_DATA, i, struct.pack("<I", PROTO))
        return parse_device(self.recv(P_DATA), i)

    def devices(self):
        out = []
        for i in range(self.count()):
            try:
                out.append(self.device(i))
            except (struct.error, IndexError):
                print(f"walrgb: couldn't read device {i}, skipping it", file=sys.stderr)
        return out

    def set_mode(self, dev, idx, m):
        name = m["name"].encode() + b"\0"
        body = struct.pack("<H", len(name)) + name + struct.pack(MODE_FMT, *(m[k] for k in MODE_KEYS)) + pack_colors(m["colors"])
        self.send(P_MODE, dev, struct.pack("<Ii", 8 + len(body), idx) + body)

    def resize(self, dev, zone, n):
        self.send(P_RESIZE, dev, struct.pack("<ii", zone, n))

    def set_leds(self, dev, cs):
        body = pack_colors(cs)
        self.send(P_LEDS, dev, struct.pack("<I", 4 + len(body)) + body)

    def close(self):
        self.count()  # round trip so the server has chewed through everything before we hang up
        self.sock.close()


def devices_quiet():
    try:
        rgb = OpenRGB()
        devs = rgb.devices()
        rgb.close()
        return devs, ""
    except OSError as e:
        return [], str(e)


# ---- config ----

def clamp(v, lo, hi, default):
    return max(lo, min(hi, v)) if isinstance(v, (int, float)) and not isinstance(v, bool) else default


def fix_mode(m):
    """older configs had more modes, fold them into the three that are left"""
    if not isinstance(m, str) or m in MODES:
        return m if m in MODES else None
    m = m.lower()
    return "rainbow" if "rainbow" in m or "spectrum" in m else "cycle" if "cycle" in m or "wave" in m else "static"


def load_cfg():
    """read the config and quietly fix anything hand edited into nonsense"""
    try:
        with open(CFG) as f:
            raw = json.load(f)
    except (OSError, ValueError):
        raw = {}
    raw = raw if isinstance(raw, dict) else {}
    cfg = json.loads(json.dumps(DEFAULT))
    for k in ("color", "manual"):
        if isinstance(raw.get(k), str):
            cfg[k] = raw[k]
    cfg["mode"] = fix_mode(raw.get("mode")) or "static"
    for k in ("devices", "zones"):
        if isinstance(raw.get(k), dict):
            cfg[k] = {n: v for n, v in raw[k].items() if isinstance(v, (dict, int))}
    for d in cfg["devices"].values():
        if "mode" in d and not fix_mode(d["mode"]):
            del d["mode"]
        elif "mode" in d:
            d["mode"] = fix_mode(d["mode"])
    cfg["enabled"] = raw.get("enabled", True) is not False
    cfg["accent"] = clamp(raw.get("accent"), 0, 15, None)
    cfg["speed"] = clamp(raw.get("speed"), 0, 100, 50)
    cfg["brightness"] = clamp(raw.get("brightness"), 0, 100, 100)
    bal = raw.get("balance")
    if isinstance(bal, list) and len(bal) == 3:
        cfg["balance"] = [clamp(x, 0.2, 1.0, 1.0) for x in bal]
    colors = raw.get("colors", (raw.get("cycle") or {}).get("colors") if isinstance(raw.get("cycle"), dict) else None)
    if isinstance(colors, list):
        cfg["colors"] = [c for c in colors if isinstance(c, str)]
    return cfg


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
        json.dump(data, f, indent=2)
    os.replace(path + ".tmp", path)  # atomic so the path unit never reads half a file


def save_cfg(cfg):
    write_json(CFG, cfg)


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def controlled(name, dtype, cfg):
    return cfg["devices"].get(name, {}).get("enabled", dtype not in PERIPHERALS)


# ---- colors ----

def hex_rgb(h):
    h = h.strip().lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    try:
        if len(h) == 6:
            return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
    except ValueError:
        pass
    raise ValueError(f"not a color: {h}. use accent, wal0-15 or a hex like #ff8800")


def to_hex(c):
    return "#%02x%02x%02x" % tuple(c)


def load_wal():
    """the 16 pywal colors, or None when pywal isn't set up"""
    try:
        with open(WAL) as f:
            pal = [hex_rgb(l) for l in f if l.strip()][:16]
    except (OSError, ValueError):
        return None
    return (pal * 2)[:16] if len(pal) >= 8 else None


def accent_slot(cfg):
    if cfg["accent"] is not None:
        return int(cfg["accent"])
    try:
        return int(read_json(ROLES, {})["accent"]) % 16
    except (KeyError, ValueError, TypeError):
        return 9  # same default my dotfiles use


def is_wal(spec):
    return spec == "accent" or spec.startswith("wal") and spec[3:].isdigit()


def resolve(spec, pal, cfg):
    """accent / walN / #hex -> rgb. without pywal the wal ones fall back to the manual color"""
    if not is_wal(spec):
        return hex_rgb(spec)
    if pal is None:
        return hex_rgb(cfg["manual"] or BLUE)
    return pal[accent_slot(cfg) if spec == "accent" else int(spec[3:]) % 16]


def safe(spec, pal, cfg):
    try:
        return resolve(spec, pal, cfg)
    except ValueError:
        return hex_rgb(BLUE)


def theme(cfg, pal):
    """the colors cycle flows through"""
    specs = cfg["colors"] or ([f"wal{i}" for i in range(1, 7)] if pal else NO_WAL_CYCLE)
    if pal is None:
        specs = [s for s in specs if not is_wal(s)] or NO_WAL_CYCLE
    out = []
    for s in specs:
        try:
            c = resolve(s, pal, cfg)
            if not out or c != out[-1]:  # same color twice in a row would just look like a stall
                out.append(c)
        except ValueError:
            pass
    return out or [safe("accent", pal, cfg)]


def dim(c, k):
    return tuple(round(v * k) for v in c)


def led(c, bal=(1, 1, 1)):
    """screen color -> what to send to the leds. screens are gamma encoded and leds are linear, so raw hex
    comes out pale and washed out. full gamma for the hue so it keeps its depth, gentler on the brightness
    so dark theme colors stay visible. bal evens out leds that run green or blue heavy"""
    v = max(c)
    if not v:
        return BLACK
    lin = [(x / 255) ** 2.2 for x in c]
    k = (v / 255) ** 1.6 / max(lin)
    return tuple(min(255, round(x * k * w * 255)) for x, w in zip(lin, bal))


def fade(a, b, t):
    """mix in linear light so the middle of a fade doesn't dip dark and muddy"""
    return tuple(round(((x / 255) ** 2.2 * (1 - t) + (y / 255) ** 2.2 * t) ** (1 / 2.2) * 255) for x, y in zip(a, b))


def blend(colors, p):
    """spot p along a looping list of colors. eased, so it settles on each color and glides between them"""
    i = int(p // 1)
    f = p - i
    return fade(colors[i % len(colors)], colors[(i + 1) % len(colors)], f * f * (3 - 2 * f))


def hue(h):
    return tuple(round(v * 255) for v in colorsys.hsv_to_rgb(h % 1, 1, 1))


# ---- modes ----

def mode_index(dev, *names):
    low = [m["name"].lower() for m in dev["modes"]]
    for n in names:
        if n in low:
            return low.index(n)
    return None


def direct_ok(dev):
    # msi mystic light boards drop off usb in direct mode and come back with a dead handle. static is fine
    return not (dev["vendor"] == "MSI" and dev["type"] == "motherboard") and mode_index(dev, "direct") is not None


def plan(dev, mode):
    """how a mode runs on a device -> (how, mode index, fps). walrgb animates both cycles itself, so they look
    and time the same on everything: through direct where it works, else by re-pushing static (slower)"""
    still = mode_index(dev, "static", "direct", "custom")  # hardware static before direct, see direct_ok
    if mode == "static" or still is None:
        return "static", still, 0
    if direct_ok(dev):
        return "direct", mode_index(dev, "direct"), 15 if dev["location"].startswith("I2C") else 20  # smbus is slow
    return "push", still, 10


def positions(dev):
    """x of every led from 0 to 1, left to right. keyboards use the real key grid"""
    xs = []
    for z in dev["zones"]:
        n = z["leds"]
        zx = [i / max(1, n - 1) for i in range(n)]
        if z["matrix"]:
            h, w, cells = z["matrix"]
            for c, v in enumerate(cells):
                if v < n:
                    zx[v] = (c % w) / max(1, w - 1)
        xs += zx
    return (xs + [0.0] * len(dev["leds"]))[:len(dev["leds"])]


def period(speed):
    """seconds spent on each color. 0 -> 60s, 50 -> ~11s, 100 -> 2s"""
    return 2 * 30 ** ((100 - speed) / 100)


def effect(mode, dev, base, colors, speed):
    """a function of wall clock time -> one color per led. wall clock keeps every device (and the tui) in step"""
    xs, per = positions(dev), period(speed)
    if mode == "rainbow":
        return lambda t: [hue(t / (per * 6) + x * 0.15) for x in xs]
    return lambda t: [blend(colors, t / per)] * len(xs)


def push(rgb, dev, i, leds, b):
    """switch dev to mode i showing these colors. returns the dimming still left for the colors"""
    m = dict(dev["modes"][i])
    if m["flags"] & F_BRIGHT:  # let the hardware dim if it can, else dim the colors ourselves
        m["brightness"] = round(m["brightness_min"] + (m["brightness_max"] - m["brightness_min"]) * b)
        b = 1
    leds = [dim(c, b) for c in leds]
    if m["flags"] & F_PER_LED:
        m["color_mode"] = CM_PER_LED
    elif m["flags"] & F_MODE_COLOR and m["colors_max"]:
        m["colors"], m["color_mode"] = [leds[0] if leds else BLACK] * max(1, m["colors_min"], len(m["colors"])), CM_MODE
    per_led = m["color_mode"] == CM_PER_LED and leds
    # colors before AND after the mode. msi static only commits colors on a mode update, direct wants them after
    if per_led:
        rgb.set_leds(dev["idx"], leds)
    rgb.set_mode(dev["idx"], i, m)
    if per_led:
        rgb.set_leds(dev["idx"], leds)
    return b


def settings(dev, cfg, pal):
    """mode, color and cycle colors for a device: its own overrides, else the all-devices ones"""
    d = cfg["devices"].get(dev["name"], {})
    return d.get("mode") or cfg["mode"], safe(d.get("color") or cfg["color"], pal, cfg), theme(cfg, pal)


def preview(dev, cfg, pal, t):
    """what the leds look like right now, for the tui"""
    n = len(dev["leds"])
    if not cfg["enabled"]:
        return [BLACK] * n
    mode, base, colors = settings(dev, cfg, pal)
    leds = [base] * n if mode == "static" else effect(mode, dev, base, colors, cfg["speed"])(t)
    return [dim(c, cfg["brightness"] / 100) for c in leds]


def setup(rgb, dev, cfg, pal):
    """put one device in its mode. returns an animation job if walrgb has to drive it"""
    n, b = len(dev["leds"]), cfg["brightness"] / 100
    mode, base, colors = settings(dev, cfg, pal) if cfg["enabled"] else ("static", BLACK, [BLACK])
    how, i, fps = plan(dev, mode)
    if i is None:
        return print(f"walrgb: {dev['name']} has no mode walrgb can use", file=sys.stderr)
    bal = cfg["balance"]
    if how == "static":
        push(rgb, dev, i, [led(base, bal)] * n, b)
        return None
    fx = effect(mode, dev, base, colors, cfg["speed"])
    return {"dev": dev, "i": i, "how": how, "fx": lambda t: [led(c, bal) for c in fx(t)], "b": b,
            "every": 1 / fps, "due": 0, "last": None}


def animate(rgb, jobs, seen):
    """drive the cycles until the config, colors or plugged in hardware change"""
    check = 0
    while True:
        now = time.monotonic()
        if now >= check:
            if stamp() != seen:
                return
            check = now + 0.5
        for j in jobs:
            if now < j["due"]:
                continue
            j["due"] = now + j["every"]
            leds = j["fx"](time.time())
            if leds == j["last"]:
                continue
            if j["last"] is None or j["how"] == "push":
                j["k"] = push(rgb, j["dev"], j["i"], leds, j["b"])
            else:
                rgb.set_leds(j["dev"]["idx"], [dim(c, j["k"]) for c in leds])
            j["last"] = leds
        time.sleep(max(0.0, min(min(j["due"] for j in jobs), check) - time.monotonic()))


# ---- reset ----

def key(dev):
    return f"{dev['name']} @ {dev['location']}"  # location tells the two identical ram sticks apart


def reset(rgb, dev):
    """hand a device back with its factory style effect. openrgb can't read what a device's real default is,
    but nearly every board, ram kit and gpu ships doing rainbow, so that's what it gets"""
    i = mode_index(dev, *FACTORY)
    if i is None:
        return False
    m = dict(dev["modes"][i])
    if m["flags"] & F_BRIGHT:
        m["brightness"] = m["brightness_max"]
    rgb.set_mode(dev["idx"], i, m)
    return True


def reset_all():
    rgb, cfg, owned = OpenRGB(), load_cfg(), set(read_json(OWNED, []))
    for dev in rgb.devices():
        if key(dev) in owned or controlled(dev["name"], dev["type"], cfg):
            print(f"{dev['name']}: {'reset' if reset(rgb, dev) else 'no factory effect, left as is'}")
    rgb.close()
    write_json(OWNED, [])


# ---- apply ----

def fit_zones(rgb, dev, cfg):
    sized = False
    for zi, z in enumerate(dev["zones"]):
        want = cfg["zones"].get(z["name"], AUTO_ZONE if z["leds"] == 0 else z["leds"])
        want = max(z["min"], min(z["max"], want if isinstance(want, int) else z["leds"]))
        if z["min"] < z["max"] and want != z["leds"]:
            rgb.resize(dev["idx"], zi, want)
            sized = True
    return rgb.device(dev["idx"]) if sized else dev


def settle(rgb, known, wait):
    """wait until the server lists as many devices as last time, or the count stops moving"""
    end = time.monotonic() + wait
    last, n = -1, rgb.count()
    while n < known and not (n and n == last) and time.monotonic() < end:
        time.sleep(0.5)
        last, n = n, rgb.count()
    return n


def hid():
    """every hid device and which usb enumeration it came from. changes when anything replugs or resets"""
    return sorted(os.path.realpath(p) for p in glob.glob("/sys/class/hidraw/*"))


def connect(wait):
    rgb = OpenRGB(wait)
    known = read_json(COUNT, 1)
    known = known if isinstance(known, int) else 1
    # on boot the server takes connections before it's done scanning and says 0 devices
    n = settle(rgb, known, wait) if wait else rgb.count()
    now, before = hid(), read_json(HID, None)
    if before is not None and now != before:
        # something replugged (my keyboard drops off its hub sometimes). openrgb keeps writing to the dead
        # handle until it rescans. wait for it to finish coming back first, a wooting brings its 4
        # interfaces up over ~2.5s and a rescan in the middle grabs a dead one
        end = time.monotonic() + 10
        while time.monotonic() < end:
            time.sleep(1.5)
            now, last = hid(), now
            if now == last:
                break
        rgb.send(P_RESCAN)
        time.sleep(0.5)
        n = settle(rgb, max(n, known), 15)
    if now != before:
        write_json(HID, now)
    if n and n != known:
        write_json(COUNT, n)
    return rgb


def stamp():
    return tuple(os.stat(p).st_mtime_ns if os.path.exists(p) else 0 for p in (CFG, WAL, ROLES)), tuple(hid())


def apply(wait=0):
    """push everything once and exit. only sticks around while a cycle needs driving"""
    while True:
        seen, cfg, pal = stamp(), load_cfg(), load_wal()
        try:
            rgb = connect(wait)
            owned = set(read_json(OWNED, []))
            before, jobs = set(owned), []
            for dev in rgb.devices():
                if not controlled(dev["name"], dev["type"], cfg):
                    if key(dev) in owned:  # just got toggled off
                        reset(rgb, dev)
                        owned.discard(key(dev))
                    continue
                owned.add(key(dev))
                job = setup(rgb, fit_zones(rgb, dev, cfg), cfg, pal)
                if job:
                    jobs.append(job)
            if owned != before:
                write_json(OWNED, sorted(owned))
            if jobs:
                animate(rgb, jobs, seen)
            rgb.close()
        except ConnectionError:
            if wait:
                raise
            wait = 60  # server restarted under us, reconnect and rescan
            continue
        if stamp() == seen:
            return
        # something changed while we were busy. the path unit can't retrigger an active unit, so go again


# ---- detect ----

def ansi(c, text="  "):
    return "\033[48;2;%d;%d;%dm%s\033[0m" % (*c, text)


def detect():
    devs, err = devices_quiet()
    if err:
        raise ConnectionError(err)
    cfg, pal = load_cfg(), load_wal()
    if pal:
        print(" pywal   " + "".join(ansi(c) for c in pal) + "   accent " + ansi(resolve("accent", pal, cfg)) + f" wal{accent_slot(cfg)}")
    else:
        print(" pywal   not found, using " + ansi(resolve("accent", pal, cfg)) + f" {cfg['manual']}")
    if not devs:
        print("\n openrgb sees no devices. check the i2c group / udev rules (see readme)")
    how = {"direct": "smooth, %d fps", "push": "smooth, %d fps through static", "static": "static only"}
    for d in devs:
        uniq = list(dict.fromkeys(d["colors"]))[:12]
        on = "\033[32mcontrolled\033[0m" if controlled(d["name"], d["type"], cfg) else "\033[2mignored\033[0m"
        h, _, fps = plan(d, "cycle")
        print(f"\n \033[1m{d['name']}\033[0m  {on}  \033[2m{d['type']}  {d['location']}\033[0m")
        print(f"   colors  {''.join(ansi(c) for c in uniq) or '-'}  " + " ".join(to_hex(c) for c in uniq[:4]))
        print("   zones   " + ", ".join(f"{z['name']} ({z['leds']}{', key grid' if z['matrix'] else ''})" for z in d["zones"]))
        print("   cycles  " + (how[h] % fps if "%" in how[h] else how[h]))


# ---- tui ----

CUBE = (0, 95, 135, 175, 215, 255)
XTERM = [(CUBE[i // 36], CUBE[i // 6 % 6], CUBE[i % 6]) for i in range(216)] + [(8 + 10 * i,) * 3 for i in range(24)]


class Tui:
    GLOBAL = ("power", "color", "mode", "speed", "brightness")
    PANEL = 70  # previews go right of the list when there's room, under it when there isn't

    def __init__(self, scr):
        self.scr, self.cfg, self.sel, self.field, self.pairs = scr, load_cfg(), 0, 0, {}
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        scr.timeout(50)  # redraw ~20x a second so the previews move
        self.refresh()

    def refresh(self):
        self.pal = load_wal()
        self.near = {}  # palette may have changed
        self.all, self.msg = devices_quiet()
        self.devs, self.counts = {}, {}
        for d in self.all:
            self.devs.setdefault(d["name"], d)
            self.counts[d["name"]] = self.counts.get(d["name"], 0) + 1
        order = lambda n: (n not in self.devs, self.devs[n]["type"] if n in self.devs else "", n)
        self.names = sorted(set(self.devs) | set(self.cfg["devices"]), key=order)
        self.all.sort(key=lambda d: order(d["name"]))
        self.colors = ["accent"] + [f"wal{i}" for i in range(16)] if self.pal else PRESETS
        if not self.pal and not self.msg:
            self.msg = "no pywal colors found, pick one or press enter for any hex"
        self.tint()

    def tint(self):
        self.accent = self.pair(fg=safe("accent", self.pal, self.cfg))
        self.dim = self.pair(fg=self.pal[8] if self.pal else (110, 110, 110))

    def term(self, c):
        """closest terminal color. 0-15 are the pywal colors themselves when wal themes the terminal,
        so palette colors show up exact instead of rounded into the 256 cube"""
        c = tuple(c)
        if c not in self.near:
            table = (list(self.pal) if self.pal else [(-999,) * 3] * 16) + XTERM
            self.near[c] = min(range(256), key=lambda i: sum((a - b) ** 2 * w for a, b, w in zip(c, table[i], (3, 4, 2))))
        return self.near[c]

    def pair(self, fg=None, bg=None):
        key = (fg and self.term(fg), bg and self.term(bg))
        if key not in self.pairs:
            n = len(self.pairs) + 1
            if n >= curses.COLOR_PAIRS or curses.COLORS < 256:
                return curses.A_NORMAL
            curses.init_pair(n, key[0] or -1, key[1] or -1)
            self.pairs[key] = curses.color_pair(n)
        return self.pairs[key]

    def put(self, y, x, s, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h - 1 and 0 <= x < w - 1:
            self.scr.addnstr(y, x, s, w - x - 1, attr)

    def swatch(self, y, x, c, w=2):
        self.put(y, x, " " * w, self.pair(bg=c))

    def lit(self, y, x, leds, glyph, cells=None):
        """a row of leds, squeezed or stretched to `cells`"""
        cells = cells or len(leds)
        for k in range(cells):
            c = leds[int(k * len(leds) / cells)] if leds else BLACK
            self.put(y, x + k * len(glyph), glyph, self.pair(fg=c) if any(c) else self.dim)
        return cells * len(glyph)

    def art(self, y, x, dev, leds):
        """draw a device by what it is. returns the rows it took"""
        hot = self.row() == dev["name"]
        self.put(y, x, dev["name"][:32], self.accent if hot else self.dim)
        y += 1
        if not controlled(dev["name"], dev["type"], self.cfg):
            self.put(y, x, "off", self.dim)
            return 3
        rows, off = 0, 0
        for z in dev["zones"]:
            zl, off = leds[off:off + z["leds"]], off + z["leds"]
            if z["matrix"]:  # keyboards, the actual key grid
                h, w, cells = z["matrix"]
                for c, v in enumerate(cells):
                    if v < len(zl):
                        self.put(y + rows + c // w, x + (c % w) * 2, "■", self.pair(fg=zl[v]) if any(zl[v]) else self.dim)
                rows += h
            elif dev["type"] == "ram":  # lights along the top of a stick
                n = self.lit(y + rows, x, zl, "▄▄")
                self.put(y + rows + 1, x, "▀" * n, self.dim)
                rows += 2
            elif not z["leds"]:
                self.put(y + rows, x, f"{z['name']}  no leds yet, walrgb zone {z['name']} N", self.dim)
                rows += 1
            else:
                self.lit(y + rows, x, zl, "▬", min(max(z["leds"], 12), 24) if dev["type"] != "motherboard" or z["leds"] > 4 else z["leds"])
                rows += 1
        return rows + 2

    def row(self):
        return self.GLOBAL[self.sel] if self.sel < len(self.GLOBAL) else self.names[self.sel - len(self.GLOBAL)]

    def draw(self):
        cfg, n = self.cfg, len(self.GLOBAL)
        h, w = self.scr.getmaxyx()
        self.scr.erase()
        self.put(1, 3, "walrgb", self.accent | curses.A_BOLD)
        for i, c in enumerate(self.pal or [hex_rgb(p) for p in PRESETS]):
            self.swatch(1, 11 + i * 2, c)
        vals = ("on" if cfg["enabled"] else "off", cfg["color"], cfg["mode"], f"{cfg['speed']}%", f"{cfg['brightness']}%")
        for i, (k, v) in enumerate(zip(self.GLOBAL, vals)):
            y, hot = 3 + i, self.sel == i
            self.put(y, 3, f"{k:<11}", self.accent if hot else self.dim)
            self.put(y, 14, v, curses.A_BOLD if hot else 0)
            x = 16 + len(v)
            if k == "color":
                self.swatch(y, x, safe(v, self.pal, cfg))
            elif k == "mode" and v == "cycle":
                for j, c in enumerate(theme(cfg, self.pal)[:10]):
                    self.swatch(y, x + j * 2, c)
            elif k == "speed" and cfg["mode"] != "static":
                self.put(y, x, f"{period(cfg['speed']):.0f}s a color", self.dim)
        y0 = 4 + n
        for j, name in enumerate(self.names):
            i, y, d = n + j, y0 + j, cfg["devices"].get(name, {})
            dev, hot = self.devs.get(name), self.sel == i
            on = controlled(name, dev["type"] if dev else None, cfg)
            text = name[:24] + (f" x{self.counts[name]}" if self.counts.get(name, 0) > 1 else "")
            self.put(y, 3, "●" if on else "○", self.accent if on else self.dim)
            self.put(y, 5, f"{text:<28}", (curses.A_BOLD if hot else 0) | (0 if on and dev else self.dim))
            for f, (v, x) in enumerate(((d.get("color") or "·", 34), (d.get("mode") or "·", 45))):
                sel = hot and self.field == f
                self.put(y, x, v, self.accent | curses.A_BOLD if sel else self.dim)
        y = y0 + len(self.names) + 1
        if self.msg:
            self.put(y, 3, self.msg, self.dim)
            y += 1
        self.put(y, 3, "↑↓ move  ←→ change  space toggle  tab column  enter hex  q quit", self.dim)
        t = time.time()
        px, py = (self.PANEL, 1) if w >= self.PANEL + 36 else (3, y + 2)
        for dev in self.all:
            py += self.art(py, px, dev, preview(dev, cfg, self.pal, t))
        self.scr.refresh()

    @staticmethod
    def step(cur, opts, d):
        return opts[(opts.index(cur) + d) % len(opts) if cur in opts else 0]

    def change(self, d):
        cfg, row = self.cfg, self.row()
        if row == "power":
            cfg["enabled"] = not cfg["enabled"]
        elif row == "color":
            cfg["color"] = self.step(cfg["color"], self.colors, d)
            self.tint()
        elif row == "mode":
            cfg["mode"] = self.step(cfg["mode"], list(MODES), d)
        elif row in ("speed", "brightness"):
            cfg[row] = max(0, min(100, cfg[row] + 10 * d))
        else:
            dev, f = cfg["devices"].setdefault(row, {}), ("color", "mode")[self.field]
            v = self.step(dev.get(f), [None] + (self.colors if f == "color" else list(MODES)), d)
            dev.pop(f, None) if v is None else dev.update({f: v})
        save_cfg(cfg)

    def toggle(self):
        row = self.row()
        if row == "power":
            return self.change(1)
        if row in self.GLOBAL:
            return
        dev = self.devs.get(row)
        self.cfg["devices"].setdefault(row, {})["enabled"] = not controlled(row, dev["type"] if dev else None, self.cfg)
        save_cfg(self.cfg)

    def prompt_hex(self):
        row = self.row()
        if row in self.GLOBAL and row != "color" or row not in self.GLOBAL and self.field != 0:
            return
        h, _ = self.scr.getmaxyx()
        self.scr.timeout(-1)
        self.put(h - 2, 3, "hex ", self.accent)
        curses.echo()
        curses.curs_set(1)
        try:
            c = to_hex(hex_rgb(self.scr.getstr(h - 2, 7, 8).decode()))
            if row == "color":
                self.cfg["color"] = c
                if not self.pal:
                    self.cfg["manual"] = c
                self.tint()
            else:
                self.cfg["devices"].setdefault(row, {})["color"] = c
            save_cfg(self.cfg)
        except ValueError as e:
            self.msg = str(e)
        finally:
            curses.noecho()
            curses.curs_set(0)
            self.scr.timeout(50)

    def run(self):
        keys = {curses.KEY_UP: -1, ord("k"): -1, curses.KEY_DOWN: 1, ord("j"): 1}
        sides = {curses.KEY_LEFT: -1, ord("h"): -1, curses.KEY_RIGHT: 1, ord("l"): 1}
        while True:
            self.draw()
            k = self.scr.getch()
            if k == ord("q"):
                return
            if k in keys:
                self.sel = (self.sel + keys[k]) % (len(self.GLOBAL) + len(self.names))
            elif k in sides:
                self.change(sides[k])
            elif k == 9:
                self.field ^= 1
            elif k == ord(" "):
                self.toggle()
            elif k in (10, 13, curses.KEY_ENTER):
                self.prompt_hex()
            elif k == ord("r"):
                self.refresh()


# ---- cli ----

USAGE = """walrgb - sync rgb hardware to pywal

  walrgb                        tui
  walrgb detect                 every device walrgb can see
  walrgb apply [--wait SECS]    push colors now (the service runs this)
  walrgb on|off|toggle [DEV]    lights on/off, or whether walrgb controls DEV
  walrgb mode static|rainbow|cycle [DEV]
  walrgb color SPEC [DEV]       accent, wal0-15 or #hex. no pywal = #hex only (default blue)
  walrgb colors [SPEC..]        what cycle flows through (default wal1-6, none = default)
  walrgb speed 0-100            how fast the cycles move. 50 is about 11s a color
  walrgb brightness 0-100
  walrgb balance R G B          0.2-1 each, tames leds that run green or blue heavy (default 1 1 1)
  walrgb zone NAME LEDS         led count for an argb header (fans, pumps, strips)
  walrgb reset                  give every device its factory effect back

DEV matches part of a device name or a type like ram, gpu, keyboard."""


def match(arg):
    devs, _ = devices_quiet()
    a = arg.lower()
    hits = {d["name"]: d["type"] for d in devs if a in d["name"].lower() or a == d["type"]}
    return hits or {arg: None}


def main(argv):
    cmd, args = (argv[0] if argv else "tui"), argv[1:]
    cfg = load_cfg()
    check = lambda spec: resolve(spec, [BLACK] * 16, cfg)
    try:
        if cmd == "tui":
            curses.wrapper(lambda s: Tui(s).run())
            return 0
        if cmd == "apply":
            return apply(float(args[1]) if args[:1] == ["--wait"] and len(args) > 1 else 0) or 0
        if cmd == "detect":
            return detect() or 0
        if cmd == "reset":
            return reset_all() or 0
        if cmd in ("on", "off", "toggle") and len(args) < 2:
            if not args:
                cfg["enabled"] = {"on": True, "off": False}.get(cmd, not cfg["enabled"])
            for name, t in (match(args[0]).items() if args else ()):
                dev = cfg["devices"].setdefault(name, {})
                dev["enabled"] = {"on": True, "off": False}.get(cmd, not controlled(name, t, cfg))
                print(f"{name}: {'controlled' if dev['enabled'] else 'ignored, back to its factory effect'}")
        elif cmd in ("color", "mode") and 1 <= len(args) <= 2:
            if cmd == "mode" and args[0] not in MODES:
                raise ValueError(f"mode is one of: {', '.join(MODES)}")
            v = args[0] if cmd == "mode" or is_wal(args[0]) else to_hex(check(args[0]))
            if cmd == "color" and not is_wal(v) and load_wal() is None:
                cfg["manual"] = v
            for target in ([cfg["devices"].setdefault(n, {}) for n in match(args[1])] if len(args) > 1 else [cfg]):
                target[cmd] = v
        elif cmd == "colors":
            for c in args:
                check(c)
            cfg["colors"] = args
        elif cmd in ("speed", "brightness") and len(args) == 1:
            cfg[cmd] = max(0, min(100, int(args[0])))
        elif cmd == "balance" and len(args) == 3:
            cfg["balance"] = [max(0.2, min(1.0, float(x))) for x in args]
        elif cmd == "zone" and len(args) == 2:
            cfg["zones"][args[0]] = int(args[1])
        else:
            print(USAGE)
            return 0 if cmd in ("-h", "--help", "help") else 1
        save_cfg(cfg)
    except (OSError, ValueError) as e:
        print(f"walrgb: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
