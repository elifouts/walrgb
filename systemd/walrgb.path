[Unit]
Description=Watch pywal colors and walrgb config
StartLimitIntervalSec=0
Wants=walrgb.service

[Path]
TriggerLimitIntervalSec=0
PathChanged=%h/.cache/wal/colors
PathChanged=%h/.config/walrgb/config.json
PathChanged=%h/.config/hypr/state/color-roles.json
# links here come and go when usb devices replug or reset. walrgb then asks openrgb to rescan. not /dev itself, /dev/null closes trigger it constantly
PathChanged=/dev/input/by-id

[Install]
WantedBy=default.target
